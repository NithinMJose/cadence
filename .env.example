# ==========================================
# Cadence Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_secret
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cadence

# Security & Authentication
# API Key for all incoming client calls (X-Cadence-Api-Key / Authorization: Bearer)
CADENCE_API_KEY=cadence-dev-secret-key-change-me

# Timezone Foundation
DEFAULT_USER_TIMEZONE=Asia/Kolkata

# Local Ollama LLM Configuration (Docker internal hostname is 'ollama', host is 'localhost')
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Google Gemini Fallback Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM Routing Policy: AUTO | LOCAL_ONLY | GEMINI_ONLY
LLM_PROVIDER_MODE=AUTO

# Privacy-first safety switch: Only fallback to Gemini if set to true AND GEMINI_API_KEY is present
ALLOW_CLOUD_FALLBACK=false

# Service Ports & URLs
AI_SERVICE_PORT=8000
BACKEND_PORT=8080
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
