# Include everything from .gitignore
**/build/
**/target/
**/.gradle/
**/node_modules/
**/.next/
**/__pycache__/
**/.venv/
*.pyc
.env
.env.local
*.local
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.pytest_cache/
.coverage
htmlcov/

# Lockfiles and binary assets excluded only from AI context to preserve token budget
**/*.lock
uv.lock
**/package-lock.json
**/gradle.lockfile
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.ico
**/*.svg
**/*.webp
**/*.pdf
**/*.jar
**/*.war
**/*.class
